{
  "$defs": {
    "ArucoCalibration": {
      "properties": {
        "arucoSize": {
          "default": 0.1,
          "description": "The physical size of the aruco marker in meters",
          "title": "ArucoSize",
          "type": "number"
        },
        "aspectWidth": {
          "default": 16,
          "description": "The width of the display aspect ratio",
          "title": "AspectWidth",
          "type": "integer"
        },
        "aspectHeight": {
          "default": 9,
          "description": "The height of the display aspect ration",
          "title": "AspectHeight",
          "type": "integer"
        },
        "screenDiagonal": {
          "default": 0.684784,
          "description": "The diagonal of the viewable part of the screen/monitor in meters",
          "title": "ScreenDiagonal",
          "type": "number"
        },
        "scaleFactor": {
          "readOnly": true,
          "title": "ScaleFactor",
          "type": "number"
        },
        "viewWidth": {
          "readOnly": true,
          "title": "ViewWidth",
          "type": "number"
        },
        "viewHeight": {
          "readOnly": true,
          "title": "ViewHeight",
          "type": "number"
        },
        "extentX": {
          "readOnly": true,
          "title": "ExtentX",
          "type": "number"
        },
        "extentY": {
          "readOnly": true,
          "title": "ExtentY",
          "type": "number"
        }
      },
      "required": [
        "scaleFactor",
        "viewWidth",
        "viewHeight",
        "extentX",
        "extentY"
      ],
      "title": "ArucoCalibration",
      "type": "object"
    },
    "BehaviorBoard": {
      "description": "Represents a Harp Behavior Board device.",
      "properties": {
        "portName": {
          "description": "The name of the device serial port.",
          "examples": [
            "COM"
          ],
          "title": "PortName",
          "type": "string"
        },
        "pulseController": {
          "anyOf": [
            {
              "$ref": "#/$defs/PulseController"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional PulseController module for generating digital output pulses.",
          "title": "PulseController"
        },
        "cameraTriggerController": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraTriggerController"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional CameraTriggerController module for emitting camera trigger pulses.",
          "title": "CameraTriggerController"
        },
        "runningWheel": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunningWheel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional RunningWheelModule module to define wheel geometry.",
          "title": "RunningWheel"
        }
      },
      "required": [
        "portName"
      ],
      "title": "BehaviorBoard",
      "type": "object"
    },
    "CalibratedSpinnakerCamera": {
      "properties": {
        "triggerFrequency": {
          "default": 50,
          "description": "The frequency at which the camera is triggered (in Hz).",
          "minimum": 1,
          "title": "TriggerFrequency",
          "type": "number"
        },
        "exposureTime": {
          "default": 15000,
          "description": "The exposure time for the camera (in microseconds).",
          "minimum": 0,
          "title": "ExposureTime",
          "type": "number"
        },
        "serialNumber": {
          "default": "00000",
          "description": "The serial number of the camera.",
          "title": "SerialNumber",
          "type": [
            "string",
            "null"
          ]
        },
        "gain": {
          "default": 1,
          "description": "The camera gain.",
          "minimum": 0,
          "title": "Gain",
          "type": "number"
        },
        "binning": {
          "default": 1,
          "description": "The binning setting for the camera.",
          "minimum": 1,
          "title": "Binning",
          "type": "integer"
        },
        "discriminatorType": {
          "const": "CalibratedSpinnakerCamera",
          "default": "CalibratedSpinnakerCamera",
          "title": "DiscriminatorType",
          "type": "string"
        },
        "calibrationFile": {
          "title": "CalibrationFile",
          "type": "string"
        }
      },
      "required": [
        "calibrationFile"
      ],
      "title": "CalibratedSpinnakerCamera",
      "type": "object"
    },
    "CameraTriggerController": {
      "description": "Represents a CameraTriggerController module on a BehaviorBoard device.",
      "properties": {
        "trigger0Frequency": {
          "description": "The frequency, in Hz, at which to emit camera triggers on Trigger0 (DO0, CameraOutput0)",
          "examples": [
            "50"
          ],
          "title": "Trigger0Frequency",
          "type": "integer"
        },
        "trigger1Frequency": {
          "description": "The frequency, in Hz, at which to emit camera triggers on Trigger1 (DO1, CameraOutput1)",
          "examples": [
            "50"
          ],
          "title": "Trigger1Frequency",
          "type": "integer"
        }
      },
      "required": [
        "trigger0Frequency",
        "trigger1Frequency"
      ],
      "title": "CameraTriggerController",
      "type": "object"
    },
    "DisplayCalibration": {
      "properties": {
        "intrinsics": {
          "$ref": "#/$defs/DisplayIntrinsics",
          "default": {
            "viewportConfiguration": {
              "height": 1.0,
              "width": 1.0,
              "x": 0.0,
              "y": 0.0
            },
            "displayWidth": 20.0,
            "displayHeight": 15.0
          },
          "description": "Intrinsics",
          "title": "Intrinsics"
        },
        "extrinsics": {
          "$ref": "#/$defs/DisplayExtrinsics",
          "default": {
            "rotation": {
              "x": 0.0,
              "y": 0.0,
              "z": 0.0
            },
            "translation": {
              "x": 0.0,
              "y": 0.0,
              "z": 0.0
            }
          },
          "description": "Extrinsics",
          "title": "Extrinsics"
        }
      },
      "title": "DisplayCalibration",
      "type": "object"
    },
    "DisplayExtrinsics": {
      "properties": {
        "rotation": {
          "$ref": "#/$defs/Vector3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          },
          "description": "Euler rotation vector (radians)",
          "title": "Rotation"
        },
        "translation": {
          "$ref": "#/$defs/Vector3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          },
          "description": "Translation vector",
          "title": "Translation"
        }
      },
      "title": "DisplayExtrinsics",
      "type": "object"
    },
    "DisplayIntrinsics": {
      "properties": {
        "viewportConfiguration": {
          "$ref": "#/$defs/ViewportConfiguration",
          "default": {
            "width": 1.0,
            "height": 1.0,
            "x": 0.0,
            "y": 0.0
          },
          "description": "The viewport configuration for this display intrinsic"
        },
        "displayWidth": {
          "default": 20,
          "description": "Physical display width",
          "minimum": 0,
          "title": "DisplayWidth",
          "type": "number"
        },
        "displayHeight": {
          "default": 15,
          "description": "Physical display height",
          "minimum": 0,
          "title": "DisplayHeight",
          "type": "number"
        }
      },
      "title": "DisplayIntrinsics",
      "type": "object"
    },
    "ExperimentSession": {
      "description": "The base class for creating ucl-open experiment models.",
      "properties": {
        "workflow": {
          "description": "Path to the workflow running the experiment.",
          "title": "Workflow",
          "type": "string"
        },
        "commit": {
          "description": "Commit hash of the experiment repo.",
          "title": "Commit",
          "type": "string"
        },
        "repositoryUrl": {
          "description": "The URL of the git repository used to version experiment source code.",
          "title": "RepositoryUrl",
          "type": "string"
        },
        "subjectId": {
          "description": "The subject id for this session.",
          "title": "SubjectId",
          "type": "string"
        },
        "sessionId": {
          "description": "The session identifier.",
          "title": "SessionId",
          "type": "string"
        }
      },
      "required": [
        "workflow",
        "commit",
        "repositoryUrl",
        "subjectId",
        "sessionId"
      ],
      "title": "ExperimentSession",
      "type": "object"
    },
    "IntrinsicsCalibrationRig": {
      "properties": {
        "rootPath": {
          "description": "The root path on which to log all data.",
          "title": "RootPath",
          "type": "string"
        },
        "version": {
          "const": "0.0.0-rc1",
          "default": "0.0.0-rc1",
          "title": "Version",
          "type": "string"
        },
        "screen": {
          "$ref": "#/$defs/Screen"
        },
        "behaviorBoard": {
          "$ref": "#/$defs/BehaviorBoard"
        },
        "camera": {
          "$ref": "#/$defs/SpinnakerCamera",
          "title": "Camera"
        }
      },
      "required": [
        "rootPath",
        "screen",
        "behaviorBoard",
        "camera"
      ],
      "title": "IntrinsicsCalibrationRig",
      "type": "object"
    },
    "PulseController": {
      "description": "Represents the PulseController module on the BehaviorBoard.",
      "properties": {
        "activePulses": {
          "description": "List of digital output lines that are enabled for pulse generation.",
          "items": {
            "type": "string"
          },
          "title": "ActivePulses",
          "type": "array"
        },
        "pulseWidths": {
          "$ref": "#/$defs/PulseWidths",
          "description": "Pulse width configuration for DO1, DO2, and DO3 lines."
        }
      },
      "required": [
        "pulseWidths"
      ],
      "title": "PulseController",
      "type": "object"
    },
    "PulseWidths": {
      "properties": {
        "PulseDO1": {
          "maximum": 65535,
          "minimum": 0,
          "title": "PulseDo1",
          "type": "integer"
        },
        "PulseDO2": {
          "maximum": 65535,
          "minimum": 0,
          "title": "PulseDo2",
          "type": "integer"
        },
        "PulseDO3": {
          "maximum": 65535,
          "minimum": 0,
          "title": "PulseDo3",
          "type": "integer"
        }
      },
      "required": [
        "PulseDO1",
        "PulseDO2",
        "PulseDO3"
      ],
      "title": "PulseWidths",
      "type": "object"
    },
    "RunningWheel": {
      "description": "Represents configuration parameters of the RunningWheel module.\nExposes wheel geometry parameters used to compute speed and distance from encoder counts.",
      "properties": {
        "countsPerRevolution": {
          "description": "Number of encoder counts per full revolution of the running wheel.",
          "title": "CountsPerRevolution",
          "type": "integer"
        },
        "wheelDiameter": {
          "description": "The diameter of the running wheel, in metric units.",
          "title": "WheelDiameter",
          "type": "number"
        }
      },
      "required": [
        "countsPerRevolution",
        "wheelDiameter"
      ],
      "title": "RunningWheel",
      "type": "object"
    },
    "Screen": {
      "properties": {
        "displayIndex": {
          "default": 1,
          "description": "Display index",
          "title": "DisplayIndex",
          "type": "integer"
        },
        "windowWidth": {
          "default": 1920,
          "description": "Width of the screen in pixels",
          "minimum": 0,
          "title": "WindowWidth",
          "type": "integer"
        },
        "windowHeight": {
          "default": 1080,
          "description": "Height of the screen in pixels",
          "minimum": 0,
          "title": "WindowHeight",
          "type": "integer"
        },
        "targetRenderFrequency": {
          "default": 60,
          "description": "Target render frequency",
          "title": "TargetRenderFrequency",
          "type": "number"
        },
        "targetUpdateFrequency": {
          "default": 120,
          "description": "Target update frequency",
          "title": "TargetUpdateFrequency",
          "type": "number"
        },
        "textureAssetsDirectory": {
          "default": "Textures",
          "description": "Calibration directory",
          "title": "TextureAssetsDirectory",
          "type": "string"
        },
        "calibration": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/DisplayCalibration"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Calibration parameters for a set of named display monitors for visual stimuli",
          "title": "Calibration"
        },
        "brightness": {
          "default": 0,
          "description": "Brightness",
          "maximum": 1,
          "minimum": -1,
          "title": "Brightness",
          "type": "number"
        },
        "contrast": {
          "default": 1,
          "description": "Contrast",
          "maximum": 1,
          "minimum": -1,
          "title": "Contrast",
          "type": "number"
        }
      },
      "title": "Screen",
      "type": "object"
    },
    "SpinnakerCamera": {
      "properties": {
        "triggerFrequency": {
          "default": 50,
          "description": "The frequency at which the camera is triggered (in Hz).",
          "minimum": 1,
          "title": "TriggerFrequency",
          "type": "number"
        },
        "exposureTime": {
          "default": 15000,
          "description": "The exposure time for the camera (in microseconds).",
          "minimum": 0,
          "title": "ExposureTime",
          "type": "number"
        },
        "serialNumber": {
          "default": "00000",
          "description": "The serial number of the camera.",
          "title": "SerialNumber",
          "type": [
            "string",
            "null"
          ]
        },
        "gain": {
          "default": 1,
          "description": "The camera gain.",
          "minimum": 0,
          "title": "Gain",
          "type": "number"
        },
        "binning": {
          "default": 1,
          "description": "The binning setting for the camera.",
          "minimum": 1,
          "title": "Binning",
          "type": "integer"
        },
        "discriminatorType": {
          "const": "SpinnakerCamera",
          "default": "SpinnakerCamera",
          "title": "DiscriminatorType",
          "type": "string"
        }
      },
      "title": "SpinnakerCamera",
      "type": "object"
    },
    "UclOpenFreeingVisionBenchmarkRig": {
      "properties": {
        "rootPath": {
          "description": "The root path on which to log all data.",
          "title": "RootPath",
          "type": "string"
        },
        "version": {
          "const": "0.0.0-rc1",
          "default": "0.0.0-rc1",
          "title": "Version",
          "type": "string"
        },
        "screen": {
          "$ref": "#/$defs/Screen"
        },
        "arucoCalibration": {
          "$ref": "#/$defs/ArucoCalibration"
        },
        "trackShapeScale": {
          "title": "TrackShapeScale",
          "type": "number"
        },
        "behaviorBoard": {
          "$ref": "#/$defs/BehaviorBoard"
        },
        "subjectCamera": {
          "$ref": "#/$defs/CalibratedSpinnakerCamera",
          "title": "SubjectCamera"
        },
        "trackCamera": {
          "$ref": "#/$defs/CalibratedSpinnakerCamera",
          "title": "TrackCamera"
        }
      },
      "required": [
        "rootPath",
        "screen",
        "arucoCalibration",
        "trackShapeScale",
        "behaviorBoard",
        "subjectCamera",
        "trackCamera"
      ],
      "title": "UclOpenFreeingVisionBenchmarkRig",
      "type": "object"
    },
    "UclOpenFreeingVisionBenchmarkTaskLogic": {
      "properties": {
        "version": {
          "const": "0.0.0-rc1",
          "default": "0.0.0-rc1",
          "title": "Version",
          "type": "string"
        },
        "name": {
          "const": "UclOpenFreeingVisionBenchmark",
          "default": "UclOpenFreeingVisionBenchmark",
          "description": "Name of the task logic",
          "title": "Name",
          "type": "string"
        },
        "taskParameters": {
          "$ref": "#/$defs/UclOpenFreeingVisionBenchmarkTaskParameters",
          "description": "Parameters of the task logic",
          "title": "TaskParameters"
        }
      },
      "required": [
        "taskParameters"
      ],
      "title": "UclOpenFreeingVisionBenchmarkTaskLogic",
      "type": "object"
    },
    "UclOpenFreeingVisionBenchmarkTaskParameters": {
      "properties": {},
      "title": "UclOpenFreeingVisionBenchmarkTaskParameters",
      "type": "object"
    },
    "Vector3": {
      "properties": {
        "x": {
          "description": "X coordinate of the point.",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Y coordinate of the point.",
          "title": "Y",
          "type": "number"
        },
        "z": {
          "description": "Z coordinate of the point.",
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Vector3",
      "type": "object"
    },
    "ViewportConfiguration": {
      "properties": {
        "width": {
          "default": 1,
          "description": "The width of the viewport as a fraction of total screen width",
          "maximum": 0,
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "default": 1,
          "description": "The height of the viewport as a fraction of total screen width",
          "maximum": 0,
          "minimum": 0,
          "title": "Height",
          "type": "number"
        },
        "x": {
          "default": 0,
          "description": "The x-coordinate of the lower left corner of the viewport as a fraction of total screen width",
          "maximum": 0,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "description": "The y-coordinate of the lower left corner of the viewport as a fraction of total screen height",
          "maximum": 0,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "ViewportConfiguration",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/UclOpenFreeingVisionBenchmarkTaskLogic"
    },
    {
      "$ref": "#/$defs/UclOpenFreeingVisionBenchmarkRig"
    },
    {
      "$ref": "#/$defs/IntrinsicsCalibrationRig"
    },
    {
      "$ref": "#/$defs/ExperimentSession"
    }
  ],
  "title": "RootModel[Union[UclOpenFreeingVisionBenchmarkTaskLogic, UclOpenFreeingVisionBenchmarkRig, IntrinsicsCalibrationRig, ExperimentSession]]"
}