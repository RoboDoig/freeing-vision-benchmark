      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aruco:DetectMarkers">
          <aruco:CameraParameters>intrinsics\camera_25224819\2026-11-19\2026-11-19T13-6-11_intrinsics.yml</aruco:CameraParameters>
          <aruco:ThresholdMethod>AdaptiveThreshold</aruco:ThresholdMethod>
          <aruco:Param1>7</aruco:Param1>
          <aruco:Param2>13</aruco:Param2>
          <aruco:MinSize>0.01</aruco:MinSize>
          <aruco:MaxSize>0.5</aruco:MaxSize>
          <aruco:CornerRefinement>Lines</aruco:CornerRefinement>
          <aruco:MarkerSize>0.04</aruco:MarkerSize>
          <aruco:SetYPerpendicular>false</aruco:SetYPerpendicular>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
