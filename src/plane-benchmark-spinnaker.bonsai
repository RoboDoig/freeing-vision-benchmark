          <aruco:Id>10</aruco:Id>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aruco:MarkerViewMatrix" />
      </Expression>
      <Expression xsi:type="Combinator">
