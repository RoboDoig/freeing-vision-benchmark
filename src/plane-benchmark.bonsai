<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:aruco="clr-namespace:Bonsai.Aruco;assembly=Bonsai.Aruco"
                 xmlns:gl="clr-namespace:Bonsai.Shaders;assembly=Bonsai.Shaders"
                 xmlns:p1="clr-namespace:UclOpenFreeingVisionBenchmark;assembly=Extensions"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:CameraCapture">
          <cv:Index>1</cv:Index>
          <cv:CaptureProperties />
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>CameraFeed</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>CameraFeed</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aruco:DetectMarkers">
          <aruco:CameraParameters>intrinsics\camera_LOGI\2026-11-18\2026-11-18T16-31-46_intrinsics.yml</aruco:CameraParameters>
          <aruco:ThresholdMethod>AdaptiveThreshold</aruco:ThresholdMethod>
          <aruco:Param1>7</aruco:Param1>
          <aruco:Param2>7</aruco:Param2>
          <aruco:MinSize>0.04</aruco:MinSize>
          <aruco:MaxSize>0.5</aruco:MaxSize>
          <aruco:CornerRefinement>Lines</aruco:CornerRefinement>
          <aruco:MarkerSize>0.04</aruco:MarkerSize>
          <aruco:SetYPerpendicular>false</aruco:SetYPerpendicular>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aruco:SelectMarker">
          <aruco:Id>10</aruco:Id>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aruco:MarkerViewMatrix" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="gl:ExtrinsicsTransform" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Item2</Selector>
      </Expression>
      <Expression xsi:type="InputMapping">
        <PropertyMappings>
          <Property Name="X" Selector="X" />
          <Property Name="Y" Selector="Y" />
          <Property Name="Z" Selector="Z" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="gl:CreateVector3">
          <gl:X>-0.0566606</gl:X>
          <gl:Y>-0.116285518</gl:Y>
          <gl:Z>-0.3884095</gl:Z>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:RobustAverage">
          <p1:Count>100</p1:Count>
          <p1:Skip xsi:nil="true" />
          <p1:Method>Mean</p1:Method>
          <p1:OutlierThreshold>3</p1:OutlierThreshold>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aruco:SelectMarker">
          <aruco:Id>11</aruco:Id>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aruco:MarkerViewMatrix" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="gl:ExtrinsicsTransform" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Item2</Selector>
      </Expression>
      <Expression xsi:type="InputMapping">
        <PropertyMappings>
          <Property Name="X" Selector="X" />
          <Property Name="Y" Selector="Y" />
          <Property Name="Z" Selector="Z" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="gl:CreateVector3">
          <gl:X>0.09424002</gl:X>
          <gl:Y>-0.0972329</gl:Y>
          <gl:Z>-0.40516144</gl:Z>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:RobustAverage">
          <p1:Count>100</p1:Count>
          <p1:Skip xsi:nil="true" />
          <p1:Method>Mean</p1:Method>
          <p1:OutlierThreshold>3</p1:OutlierThreshold>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aruco:SelectMarker">
          <aruco:Id>12</aruco:Id>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aruco:MarkerViewMatrix" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="gl:ExtrinsicsTransform" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Item2</Selector>
      </Expression>
      <Expression xsi:type="InputMapping">
        <PropertyMappings>
          <Property Name="X" Selector="X" />
          <Property Name="Y" Selector="Y" />
          <Property Name="Z" Selector="Z" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="gl:CreateVector3">
          <gl:X>0.05647206</gl:X>
          <gl:Y>0.11932046</gl:Y>
          <gl:Z>-0.483005762</gl:Z>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:RobustAverage">
          <p1:Count>100</p1:Count>
          <p1:Skip xsi:nil="true" />
          <p1:Method>Mean</p1:Method>
          <p1:OutlierThreshold>3</p1:OutlierThreshold>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aruco:SelectMarker">
          <aruco:Id>13</aruco:Id>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aruco:MarkerViewMatrix" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="gl:ExtrinsicsTransform" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Item2</Selector>
      </Expression>
      <Expression xsi:type="InputMapping">
        <PropertyMappings>
          <Property Name="X" Selector="X" />
          <Property Name="Y" Selector="Y" />
          <Property Name="Z" Selector="Z" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="gl:CreateVector3">
          <gl:X>-0.0942411</gl:X>
          <gl:Y>0.0999424</gl:Y>
          <gl:Z>-0.466183633</gl:Z>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:RobustAverage">
          <p1:Count>100</p1:Count>
          <p1:Skip xsi:nil="true" />
          <p1:Method>Mean</p1:Method>
          <p1:OutlierThreshold>3</p1:OutlierThreshold>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>MarkerCentroids</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:KabschFit">
          <p1:ReferenceFileName>..\markers\calibration_sheet.json</p1:ReferenceFileName>
          <p1:MarkerIds>
            <p1:int>10</p1:int>
            <p1:int>11</p1:int>
            <p1:int>12</p1:int>
            <p1:int>13</p1:int>
          </p1:MarkerIds>
          <p1:ReferenceScale>1</p1:ReferenceScale>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>ArenaFit</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>CameraFeed</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:ConvertColor">
          <cv:Conversion>Bgr2Hsv</cv:Conversion>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:HsvThreshold">
          <cv:Lower>
            <cv:Val0>0</cv:Val0>
            <cv:Val1>80</cv:Val1>
            <cv:Val2>120</cv:Val2>
            <cv:Val3>0</cv:Val3>
          </cv:Lower>
          <cv:Upper>
            <cv:Val0>40</cv:Val0>
            <cv:Val1>140</cv:Val1>
            <cv:Val2>190</cv:Val2>
            <cv:Val3>0</cv:Val3>
          </cv:Upper>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:FindContours">
          <cv:Mode>External</cv:Mode>
          <cv:Method>ChainApproxNone</cv:Method>
          <cv:Offset>
            <cv:X>0</cv:X>
            <cv:Y>0</cv:Y>
          </cv:Offset>
          <cv:MinArea xsi:nil="true" />
          <cv:MaxArea xsi:nil="true" />
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:BinaryRegionAnalysis" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:LargestBinaryRegion" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Centroid</Selector>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>TrackedCentroid</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>TrackedCentroid</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ArenaFit</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:WithLatestFrom" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:ProjectToPlane">
          <p1:Height>0</p1:Height>
          <p1:Convention>OpenGL</p1:Convention>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>TrackedProjection</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>PlanePosition</Selector>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>TrackedPlanePosition</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>CameraPosition</Selector>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>TrackedCameraPosition</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:LoadIntrinsics">
          <cv:FileName>intrinsics\camera_LOGI\2026-11-18\2026-11-18T16-31-46_intrinsics.yml</cv:FileName>
        </Combinator>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="FocalLength" Selector="FocalLength" />
          <Property Name="PrincipalPoint" Selector="PrincipalPoint" />
          <Property Name="RadialDistortion" Selector="RadialDistortion" />
          <Property Name="TangentialDistortion" Selector="TangentialDistortion" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:UndistortPoints">
          <cv:ImageSize xsi:nil="true" />
          <cv:Alpha>0</cv:Alpha>
        </Combinator>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="3" To="11" Label="Source1" />
      <Edge From="3" To="18" Label="Source1" />
      <Edge From="3" To="25" Label="Source1" />
